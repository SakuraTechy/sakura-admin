# sakura-admin Docker 部署参数。
# 仅供本机部署使用，本文件已被 Git 忽略；生产环境请替换密码和 Token。

# Docker 容器网络配置
NETWORK_NAME=sakura-admin-network
NETWORK_SUBNET=192.172.0.0/24
NETWORK_GATEWAY=192.172.0.1

# 数据库配置
MYSQL_IMAGE=mysql:8.0.33
MYSQL_HOST_PORT=53306
MYSQL_ROOT_PASSWORD=3edc%RFV
MYSQL_DATABASE=continew_admin

# Redis 配置
REDIS_IMAGE=redis:7.2.3
REDIS_HOST_PORT=56379
REDIS_PASSWORD=3edc%RFV

# Schedule Server 定时任务配置
SCHEDULE_HTTP_HOST_PORT=18001
SCHEDULE_NETTY_HOST_PORT=51788
SCHEDULE_DATABASE=continew_admin_job
# SCHEDULE_TOKEN 必须与调度库 snail-job_data.sql 中的客户端 Token 一致。
SCHEDULE_TOKEN=SJ_Wyz3dmsdbDOkDujOTSSoBjGQP1BMsVnj

# Nginx 服务配置
NGINX_HOST_PORT=5183

# Sakura Playwright Runner 配置
SAKURA_PLAYWRIGHT_RUNNER_ENABLED=true
SAKURA_PLAYWRIGHT_RUNNER_ROOT=/app/sakura-playwright
# Sakura Playwright 调用 Admin API 配置
SAKURA_ADMIN_API=true
# Sakura Playwright 与 Admin 在同一容器内，使用 Admin 的本地生产端口。
SAKURA_ADMIN_API_BASE=http://127.0.0.1:18000
# NPM 配置
DEBIAN_MIRROR=mirrors.aliyun.com
NPM_REGISTRY=https://registry.npmmirror.com
PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/playwright
PLAYWRIGHT_CHROMIUM_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/playwright
PLAYWRIGHT_DOWNLOAD_CONNECTION_TIMEOUT=120000

# Sakura Execution Agent 配置
# Admin 使用 network_mode: service:sakura-execution-agent 和 Execution Agent 共用端口，通过此端口与 Agent 通信。
ADMIN_HOST_PORT=18000
ADMIN_SNAIL_PORT=51789
# install-agent.sh 生成的共享凭据文件，不要在此重复生成 Token。
SAKURA_AGENT_ENV_FILE=./sakura-execution-agent/conf/agent.env

# 未设置时，start-docker.sh 自动获取服务器 IPv4 并生成 http://<IP>:5183。
# PROJECT_URL=
