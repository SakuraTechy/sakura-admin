ted_at, e.finished_at) / 1000 ELSE (SELECT COALESCE(SUM(COALESCE(NULLIF(cw.wall_clock_duration_ms, 0), NULLIF(cw.duration_ms, 0), CASE WHEN cw.started_at IS NOT NULL AND cw.finished_at IS NOT NULL THEN TIMESTAMPDIFF(MICROSECOND, cw.started_at, cw.finished_at) / 1000 ELSE 0 END)), 0) FROM automation_ui_execution_case cw WHERE cw.execution_id = e.id) END, 0) AS duration_ms, e.error_code, LEFT(e.error_message, 512) AS error_message, e.create_time, e.update_time FROM (SELECT candidate.*, ROW_NUMBER() OVER (PARTITION BY candidate.scene_id ORDER BY candidate.create_time DESC, candidate.id DESC) AS scoped_rank FROM automation_ui_execution candidate WHERE candidate.scene_id IN (887657618946917337) AND (candidate.record_source = 'test' OR (candidate.record_source IS NULL AND (candidate.record_type IS NULL OR LOWER(Trim( candidate.record_type )) NOT IN ('internal-interactive-context', 'interactive-execution-context')) AND (candidate.test_plan_id IS NOT NULL OR candidate.test_report_id IS NOT NULL OR LOWER(Trim( candidate.trigger_type )) IN ('test-plan', 'schedule')))) AND candidate.test_plan_id = 903698866249924768 AND candidate.test_report_id = 905096794696843330) e JOIN automation_ui_scene s ON s.id = e.scene_id AND s.del_flag = 3 JOIN project_config p ON p.id = s.project_id AND p.del_flag = 3 JOIN project_version_config pv ON pv.id = s.version_id AND pv.project_id = s.project_id AND pv.del_flag = 3 JOIN project_module_config pm ON pm.id = s.module_id AND pm.project_id = s.project_id AND pm.version_id = s.version_id AND pm.del_flag = 3 WHERE e.scoped_rank = 1 AND (false = TRUE OR s.create_user = 903688327171932161 OR p.create_user = 903688327171932161 OR JSON_CONTAINS(COALESCE(p.member, JSON_ARRAY( ) ), JSON_QUOTE(CAST(903688327171932161 AS CHAR)))) ORDER BY e.scene_id

